(lab_tls) {
  tls /certs/acmefin.test.pem /certs/acmefin.test-key.pem
}

test.acmefin.test {
  import lab_tls
  reverse_proxy whoami:80
}

ldapadmin.acmefin.test {
  import lab_tls
  reverse_proxy phpldapadmin:80
}

sso.acmefin.test {
  import lab_tls
  reverse_proxy keycloak:8080
}

git.acmefin.test {
  import lab_tls
  reverse_proxy gitea:3000
}

grafana.acmefin.test {
  import lab_tls
  reverse_proxy grafana:3000
}
